{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://studyshare-backend-1-vopy.onrender.com/api/:path*" },
    { "source": "/socket.io", "destination": "https://studyshare-backend-1-vopy.onrender.com/socket.io/" },
